{
  "name": "shifted-maps-web",
  "license": "GPL-3.0",
  "version": "1.7.0",
  "description": "Shifted Maps visualizes personal movement data as a network of map extracts showing visited places.",
  "repository": "lennerd/shifted-maps",
  "bugs": {
    "url": "https://github.com/lennerd/shifted-maps/issues"
  },
  "scripts": {
    "build": "URL=http://localhost:3000/ next build --webpack",
    "dev": "URL=http://localhost:3000/ next dev",
    "format:check": "prettier --check \"tests/**/*.ts\" playwright.config.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "URL=http://localhost:3000/ next dev",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "body-scroll-lock": "^3.0.3",
    "classnames": "^2.2.6",
    "d3-force": "3.0.0",
    "d3-scale": "4.0.2",
    "leaflet": "1.9.4",
    "lodash": "^4.17.19",
    "mobx": "7.0.3",
    "mobx-react": "10.0.2",
    "next": "16.3.5",
    "normalize.css": "^8.0.0",
    "polished": "4.3.1",
    "react": "19.3.0",
    "react-compound-slider": "3.4.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@svgr/webpack": "8.1.0",
    "@types/d3-force": "3.0.10",
    "@types/d3-scale": "4.0.9",
    "@types/leaflet": "1.9.22",
    "@types/lodash": "^4.14.157",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.8",
    "typescript": "6.0.3"
  }
}
