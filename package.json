    "lodash": "^4.17.19",
    "mobx": "6.16.1",
    "mobx-react": "7.6.0",
    "moment": "^2.27.0",
    "next": "15.5.25",
    "normalize.css": "^8.0.0",
    "polished": "^3.6.5",
    "popmotion": "^8.7.3",
    "react": "18.3.1",
    "react-compound-slider": "3.4.0",
