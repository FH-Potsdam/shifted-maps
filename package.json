    "@types/d3-scale": "4.0.9",
    "@types/leaflet": "1.9.21",
    "@types/lodash": "^4.14.157",
    "@types/node": "18.19.130",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-transition-group": "^4.4.0",
    "@types/styled-components": "^5.1.1",
    "prettier": "2.0.5",
    "tslint": "^6.1.2",
    "tslint-config-prettier": "^1.15.0",
    "typescript": "6.0.3"
  }
