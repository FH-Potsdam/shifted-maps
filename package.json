    "url": "https://github.com/lennerd/shifted-maps/issues"
  },
  "scripts": {
    "build": "URL=http://localhost:3000/ next build",
    "dev": "URL=http://localhost:3000/ next dev",
    "format:check": "prettier --check \"tests/**/*.ts\" playwright.config.js",
    "lint": "tslint --project tsconfig.json",
    "start": "URL=http://localhost:3000/ next dev",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
