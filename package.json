    "classnames": "^2.2.6",
    "d3-force": "^2.0.1",
    "d3-scale": "4.0.2",
    "debug": "^4.1.0",
    "leaflet": "1.9.4",
    "lodash": "^4.17.19",
    "mobx": "6.16.1",
    "mobx-react": "9.2.2",
    "next": "16.3.5",
    "normalize.css": "^8.0.0",
    "polished": "^3.6.5",
    "popmotion": "^8.7.3",
    "react": "19.3.0",
    "react-compound-slider": "3.4.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "react-transition-group": "^4.4.1",
    "styled-components": "^5.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@svgr/webpack": "8.1.0",
